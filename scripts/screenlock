#!/usr/bin/env bash
# ── screenlock ────────────────────────────────────────────────────────────────
set -eo pipefail

LOCK_DIR="$HOME/.config/quickshell/modules/default/screenlock"
LOCK_FILE="/tmp/screenlock-$UID.lock"

log() { echo "[$(date '+%H:%M:%S')] screenlock: $*"; }

# ── Instância única ───────────────────────────────────────────────────────────
if [ -f "$LOCK_FILE" ]; then
  PID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    log "Já ativo (PID: $PID) — saindo"
    exit 0
  fi
  rm -f "$LOCK_FILE"
fi
echo $$ > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"; log "Encerrado"' EXIT

[ -z "${WAYLAND_DISPLAY:-}" ] && { log "Wayland não disponível"; exit 1; }

# ── Pré-lock ──────────────────────────────────────────────────────────────────
command -v playerctl >/dev/null 2>&1 && playerctl pause 2>/dev/null || true
systemctl --user is-active --quiet swaync.service 2>/dev/null \
  && swaync-client -dn 2>/dev/null || true
timeout 4 bwmenu-hyprland -l 2>/dev/null || true

# Pausa o timer de wallpaper para evitar que swww/hyprpaper acorde o display
_wp_timer_was_active=0
if systemctl --user is-active --quiet wallpaper-schedule.timer 2>/dev/null; then
  _wp_timer_was_active=1
  systemctl --user stop wallpaper-schedule.timer wallpaper-schedule.service 2>/dev/null || true
  log "wallpaper-schedule.timer pausado"
fi

# ── Lock (bloqueante) ─────────────────────────────────────────────────────────
log "Iniciando..."
qs -c "$LOCK_DIR"
log "Desbloqueado"

# ── Pós-unlock ────────────────────────────────────────────────────────────────
# Reativa o timer de wallpaper se estava ativo
if [[ $_wp_timer_was_active -eq 1 ]]; then
  systemctl --user start wallpaper-schedule.timer 2>/dev/null || true
  log "wallpaper-schedule.timer reativado"
fi

systemctl --user is-active --quiet swaync.service 2>/dev/null \
  && swaync-client -dn 2>/dev/null || true
