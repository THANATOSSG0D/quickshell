#!/usr/bin/env bash
# ================= CONFIGURAÇÃO BÁSICA =================
set -euo pipefail
LOG="$HOME/.local/state/screenlock.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Screenlock iniciado"

# ================= VARIÁVEIS =================
LOCK_FILE="$HOME/.cache/screenlock-$UID.lock"
STATE_FILE="$HOME/.cache/quickshell-lockstate"
FULLSCREEN="$HOME/.config/hypr/scripts/fullscreen_state.sh"
MONITOR_TOGGLE="$HOME/.config/hypr/scripts/monitor-toggle.sh"
FONT="JetBrainsMono Nerd Font"
LOCK_IMG="$HOME/.config/ml4w/cache/lockscreen/lock.png"
PRE_LOCK="$HOME/.config/ml4w/scripts/pre-lock"
FALLBACK_IMG="$HOME/Imagens/wallpaper.png"

# ================= LOCK ATÔMICO =================
cleanup_lock() {
  rm -f "$LOCK_FILE"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Lock file removido"
}
trap cleanup_lock EXIT

state_is_locked() {
  [ -f "$STATE_FILE" ] && grep -q "^locked$" "$STATE_FILE"
}

# Limpa state file órfão: se diz "locked" mas QS não está rodando,
# ou se QS está rodando mas o IPC não confirma lock ativo
if state_is_locked; then
  if ! pgrep -x qs >/dev/null 2>&1; then
    echo "State file diz locked mas QS não está rodando — limpando state file órfão"
    echo "unlocked" > "$STATE_FILE"
  elif pgrep -x swaylock >/dev/null 2>&1; then
    echo "swaylock já está rodando, saindo..."
    exit 0
  else
    # QS está rodando e state diz locked — confia
    echo "QS já está bloqueado (state file confirmado), saindo..."
    exit 0
  fi
fi

if pgrep -x swaylock >/dev/null 2>&1; then
  echo "swaylock já está rodando, saindo..."
  exit 0
fi

if [ -f "$LOCK_FILE" ]; then
  PID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    echo "Lock file válido encontrado (PID: $PID), saindo..."
    exit 0
  fi
  echo "Lock file órfão detectado, removendo..."
  rm -f "$LOCK_FILE"
fi

echo $$ >"$LOCK_FILE"

# ================= VERIFICAÇÕES =================
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  echo "ERRO: Wayland não está disponível"
  exit 1
fi

# Verifica/gera imagem de lock
if [ ! -f "$LOCK_IMG" ]; then
  echo "Imagem de lock não encontrada — executando pre-lock..."
  if [ -x "$PRE_LOCK" ]; then
    "$PRE_LOCK" || echo "Aviso: pre-lock falhou"
  fi
fi

if [ ! -f "$LOCK_IMG" ]; then
  if [ -f "$FALLBACK_IMG" ]; then
    LOCK_IMG="$FALLBACK_IMG"
    echo "Usando imagem fallback: $LOCK_IMG"
  else
    echo "Aviso: nenhuma imagem de lock disponível"
  fi
fi

# ================= PRÉ-LOCK =================
"$FULLSCREEN" save || echo "Aviso: fullscreen save falhou"
pactl list sinks short 2>/dev/null | awk '{print $1}' | while read -r idx; do
  pactl set-sink-mute "$idx" 1 || true
done
pulsemixer --mute 2>/dev/null || true
bwmenu-hyprland -l 2>/dev/null || true

DUAL_ACTIVE=$(hyprctl monitors -j \
  | jq -r '[.[] | select(.name | test("HEADLESS"; "i") | not) | .name] | length' \
  || echo "1")

if [ "$DUAL_ACTIVE" -eq 2 ]; then
  "$MONITOR_TOGGLE" --quiet --no-waybar laptop off || true
fi

if systemctl --user is-active --quiet swaync.service 2>/dev/null; then
  swaync-client -dn >/dev/null 2>&1 || true
  echo "Notificações pausadas (swaync)"
else
  echo "swaync não está ativo, pulando..."
fi

if command -v playerctl >/dev/null 2>&1; then
  playerctl pause >/dev/null 2>&1 || true
  echo "Mídia pausada"
fi

# ================= LOCK =================
echo "Executando lock..."
sleep 0.2

USE_QS=false

if pgrep -x qs >/dev/null 2>&1; then
  if qs ipc call screenLock lock 2>/dev/null; then
    USE_QS=true
    echo "QS lock ativado"

    # Fase 1: aguarda o QML confirmar lock (state file = "locked")
    # O IPC retorna imediatamente mas o Process QML escreve o arquivo
    # de forma assíncrona — sem essa espera o script leria "unlocked"
    # e sairia do loop instantaneamente antes do usuário desbloquear
    echo "Aguardando confirmação do lock..."
    CONFIRMED=false
    for i in $(seq 1 40); do
      sleep 0.1
      if state_is_locked; then
        CONFIRMED=true
        echo "Lock confirmado após $((i * 100))ms"
        break
      fi
    done

    if [ "$CONFIRMED" = "false" ]; then
      echo "AVISO: state file não confirmou lock em 4s — forçando estado"
      echo "locked" > "$STATE_FILE"
    fi

    # Fase 2: aguarda desbloqueio (state file = "unlocked")
    echo "Aguardando desbloqueio..."
    TIMEOUT=7200; COUNT=0
    while state_is_locked; do
      sleep 0.5
      COUNT=$((COUNT + 1))
      if [ "$COUNT" -ge "$TIMEOUT" ]; then
        echo "AVISO: timeout 1h atingido, forçando unlock"
        qs ipc call screenLock unlock 2>/dev/null || true
        break
      fi
    done
    echo "QS desbloqueado após $((COUNT / 2))s"
  else
    echo "qs ipc call falhou — usando swaylock como fallback"
  fi
else
  echo "QS não está rodando — usando swaylock como fallback"
fi

# ── Fallback: swaylock ────────────────────────────────────────────────────────
if [ "$USE_QS" = "false" ]; then
  if ! command -v swaylock >/dev/null 2>&1; then
    echo "ERRO: nem QS nem swaylock disponíveis"
    exit 1
  fi

  echo "Executando swaylock..."

  run_swaylock() {
    local args=(--font "$FONT" -e --ring-color 00000000 --line-color 00000000)

    if [ -f "$LOCK_IMG" ]; then
      while IFS= read -r mon; do
        args+=(--image "${mon}:${LOCK_IMG}")
      done < <(hyprctl monitors -j 2>/dev/null \
        | jq -r '.[] | select(.name | test("HEADLESS";"i") | not) | .name' || true)
      [ "${#args[@]}" -eq 4 ] && args+=(--image "$LOCK_IMG")
    fi

    swaylock "${args[@]}" 2>&1 | tee -a "$LOG"
    return "${PIPESTATUS[0]}"
  }

  STATUS=0
  if ! run_swaylock; then
    STATUS=$?
    echo "swaylock falhou (status $STATUS), tentando novamente em 1s..."
    sleep 1
    if ! run_swaylock; then
      STATUS=$?
      echo "swaylock falhou novamente (status $STATUS)"
    else
      STATUS=0
      echo "swaylock OK na segunda tentativa"
    fi
  else
    echo "swaylock OK"
  fi
fi

# ================= RESTAURAÇÃO =================
echo "Restaurando sessão..."

if [ "$DUAL_ACTIVE" -eq 2 ]; then
  hyprctl dispatch dpms on || true
  sleep 0.5

  CURRENTLY_ON=$(hyprctl monitors -j \
    | jq -r 'any(.[]; .name == "eDP-1" and .dpmsStatus == true and (.disabled == false))' \
    || echo "true")

  if [[ "$CURRENTLY_ON" == "false" ]]; then
    "$MONITOR_TOGGLE" --quiet --no-waybar laptop on || true
    sleep 0.3
  fi

  hyprctl dispatch dpms on || true
fi

unmute_audio() {
  # Após dpms off/on o pulsemixer pode perder referência do sink correto.
  # Desmuta todos os sinks via pactl para garantir.
  local ok=false

  # Tenta até 5x com backoff — PipeWire pode demorar a responder após dpms
  for i in 1 2 3 4 5; do
    if pactl list sinks short 2>/dev/null | awk '{print $1}' | while read -r idx; do
        pactl set-sink-mute "$idx" 0 || true
      done; then
      ok=true
      echo "Audio desmutado (pactl all-sinks, tentativa $i)"
      break
    fi
    sleep 0.3
  done

  # Fallback: pulsemixer e wpctl
  if [ "$ok" = "false" ]; then
    pulsemixer --unmute 2>/dev/null \
      && echo "Audio desmutado (pulsemixer fallback)" \
      || true
    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null \
      && echo "Audio desmutado (wpctl fallback)" \
      || echo "Aviso: todos os métodos de unmute falharam"
  fi
}
unmute_audio
"$FULLSCREEN" restore || echo "Aviso: fullscreen restore falhou"

if systemctl --user is-active --quiet wallpaper-schedule.timer 2>/dev/null; then
  systemctl --user start wallpaper-schedule.timer || true
fi

if systemctl --user is-active --quiet swaync.service 2>/dev/null; then
  swaync-client -dn >/dev/null 2>&1 || true
  echo "Notificações retomadas (swaync)"
else
  echo "swaync não está ativo, pulando..."
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Screenlock encerrado"
exit 0
