{
    "bar": {
        "autoHide": false,
        "barMargin": 3,
        "barSize": 30,
        "pillWidth": 800,
        "position": 4,
        "theme": "Pill"
    },
    "mediaPlayer": {
        "scrollPauseMs": 1800,
        "scrollSpeed": 40,
        "scrollWidth": 140,
        "textMode": "artistAndTitle"
    },
    "modules": {
        "bottom": [
            "clock",
            "separator",
            "volume"
        ],
        "center": [
            "workspaces"
        ],
        "left": [
            "mediaplayer"
        ],
        "middle": [
            "workspaces"
        ],
        "right": [
            "quicksettings",
            "separator",
            "clock",
            "separator",
            "volume"
        ],
        "top": [
            "mediaplayer",
            "separator",
            "quicksettings"
        ]
    },
    "themes": {
        "Pill": {
            "clock": {
                "accentColor": "primary",
                "dimColor": "on_surface_variant",
                "dismissDelayMs": 8000,
                "textColor": "on_surface"
            },
            "mediaPlayer": {
                "bgColor": "surface_variant",
                "bgColorActive": "primary_container",
                "bgEnabled": false,
                "bgOpacity": 0.5,
                "bgOpacityActive": 0.8,
                "bgPaddingH": 8,
                "bgPaddingV": 4,
                "dimColor": "on_surface_variant",
                "dimColorActive": "on_surface_variant",
                "textColor": "on_surface",
                "textColorActive": "on_primary_container"
            },
            "palette": {
                "accent": "primary",
                "accentBg": "primary_container",
                "accentText": "on_primary",
                "barBg": "surface_container_lowest",
                "barBgPill": "background",
                "divider": "outline_variant",
                "panelBg": "surface_container",
                "progressBg": "outline_variant",
                "progressFg": "primary",
                "text": "on_surface",
                "textDim": "on_surface_variant"
            },
            "volume": {
                "accentColor": "primary",
                "dimColor": "on_surface_variant",
                "mutedColor": "error",
                "textColor": "on_surface"
            },
            "workspaces": {
                "bgBorderColor": "on_surface",
                "bgBorderColorActive": "primary",
                "bgBorderWidthActive": 0,
                "bgColor": "surface_variant",
                "bgColorActive": "primary_container",
                "bgOpacity": 0.4,
                "bgOpacityActive": 0.85,
                "bgPaddingH": 8,
                "bgPaddingHActive": 6,
                "bgPaddingV": 2,
                "bgPaddingVActive": 2,
                "bgRadiusActive": 99,
                "dotActiveColor": "on_surface",
                "dotColor": "on_surface",
                "dotOccupiedColor": "on_surface",
                "dotUrgentColor": "error",
                "iconMonoColor": "on_surface",
                "iconMonoColorActive": "primary"
            }
        }
    },
    "workspaces": {
        "iconMonochrome": true,
        "iconSpacing": 4,
        "iconsSort": "position",
        "showAddButton": true,
        "style": "icons"
    }
}
