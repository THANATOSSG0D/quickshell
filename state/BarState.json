{
    "overrides": {
        "Pill": {
            "bar": {
                "autoHide": false,
                "modules": {
                    "bottom": [
                        "clock",
                        "separator",
                        "volume",
                        "separator",
                        "notifications"
                    ],
                    "middle": [
                        "workspaces"
                    ],
                    "top": [
                        "mediaplayer",
                        "separator",
                        "quicksettings"
                    ]
                },
                "position": 1
            },
            "clock": {
                "accentColor": "primary",
                "dimColor": "on_surface_variant",
                "dismissDelayMs": 8000,
                "textColor": "on_surface"
            },
            "mediaplayer": {
                "artworkSize": 17,
                "bgEnabled": true,
