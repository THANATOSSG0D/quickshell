                    "bgOpacity": 0.3,
                    "bgOpacityActive": 0.3,
                    "bgPaddingH": 4,
                    "bgPaddingHActive": 8,
                    "bgPaddingV": 2,
                    "bgPaddingVActive": 2,
                    "bgRadiusActive": 20,
                    "dotActiveColor": "on_surface",
                    "dotColor": "on_surface",
                    "dotOccupiedColor": "on_surface",
                    "dotUrgentColor": "error",
                    "iconMonoColor": "on_surface_variant",
                    "iconMonoColorActive": "primary"
                },
                "iconsSort": "position",
                "numberBgEnabled": true,
                "numberBgPaddingH": 3,
                "numberBgPaddingV": 1,
                "numberColorActive": "on_primary",
                "numberSpacing": 4,
